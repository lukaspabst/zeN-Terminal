    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
