{
  "name": "zen-terminal",
  "private": true,
  "version": "1.0.0",
  "description": "zeN-Terminal // Windows PowerShell, Windows Terminal & CMD Theme Engine powered by @zen-ui/system",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5185",
